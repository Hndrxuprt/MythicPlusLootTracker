<UI>
    <Frame name="MPLT_AltManagerSlotTemplate" virtual="true">
        <Size x="24" y="24"/>
        <Layers>
            <Layer level="OVERLAY">
                <Texture parentKey="Slot" atlas="talents-node-choiceflyout-square-yellow" useAtlasSize="false">
                    <Size x="24" y="24"/>
                    <Color r="1" g="1" b="1" a="1"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="SlotIcon">
                    <Size x="26" y="26"/>
                    <Anchors>
                        <Anchor point="CENTER" relativeKey="$parent.Slot" relativePoint="CENTER"/>
                    </Anchors>
                </Texture>
                <MaskTexture parentKey="SlotIconMask" atlas="talents-node-choiceflyout-mask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
                    <MaskedTextures>
                        <MaskedTexture childKey="SlotIcon"/>
                    </MaskedTextures>
                    <Size x="23" y="23"/>
                    <Anchors>
                        <Anchor point="CENTER" relativeKey="$parent.SlotIcon" relativePoint="CENTER"/>
                    </Anchors>
                </MaskTexture>
            </Layer>
        </Layers>
    </Frame>

    <Frame name="MPLT_AltManagerDungeonSlotTemplate" virtual="true">
        <Size x="24" y="24"/>
        <Layers>
            <Layer level="OVERLAY">
                <Texture parentKey="SlotIcon">
                    <Size x="24" y="24"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                </Texture>
                <MaskTexture parentKey="SlotIconMask" atlas="talents-node-choiceflyout-mask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
                    <MaskedTextures>
                        <MaskedTexture childKey="SlotIcon"/>
                    </MaskedTextures>
                    <Size x="23" y="23"/>
                    <Anchors>
                        <Anchor point="CENTER" relativeKey="$parent.SlotIcon" relativePoint="CENTER"/>
                    </Anchors>
                </MaskTexture>
                <FontString parentKey="SlotLvl" inherits="GameFontDisableSmall" justifyH="CENTER" justifyV="TOP" maxLines="1">
                    <Anchors>
                        <Anchor point="TOP" x="0" y="-2"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>

    <Frame name="MPLT_AltManagerTemplate" virtual="true">
        <Size x="600" y="84"/>
        <Frames>
            <Frame parentKey="CharacterFrame" inherits="MPLT_NineSliceBorderTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="TOPRIGHT"/>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture parentKey="BackgroundTile" atlas="auctionhouse-background-sell-right" useAtlasSize="true" vertTile="true" horizTile="true">
                            <Color r="1" g="1" b="1" a="1"/>
                            <Anchors>
                                <Anchor point="TOPLEFT" x="4" y="-2" />
                                <Anchor point="BOTTOMRIGHT" x="-4" y="6"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                    <Layer level="ARTWORK">
                        <FontString parentKey="CharName" inherits="Fancy48Font" justifyH="CENTER" justifyV="TOP" maxLines="1">
                            <Anchors>
                                <Anchor point="TOPLEFT" relativeKey="$parent" relativePoint="TOPLEFT" x="15" y="-8"/>
                            </Anchors>
                        </FontString>
                        <FontString parentKey="CharIlvl" inherits="GameFontDisableSmall" justifyH="CENTER" justifyV="TOP" maxLines="1">
                            <Anchors>
                                <Anchor point="TOPLEFT" relativeKey="$parent" relativePoint="TOPLEFT" x="170" y="-15"/>
                            </Anchors>
                        </FontString>
                        <FontString parentKey="CharKeystone" inherits="GameFontDisableSmall" justifyH="LEFT" justifyV="TOP" maxLines="2">
                            <Size x="150" y="40"/>
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent" relativePoint="LEFT" x="15" y="-18"/>
                            </Anchors>
                        </FontString>
                        <FontString parentKey="CharDate" inherits="GameFontDisableSmall" justifyH="CENTER" justifyV="TOP" maxLines="1">
                            <Anchors>
                                <Anchor point="BOTTOM" relativeKey="$parent" relativePoint="BOTTOM" x="0" y="20"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
            <Frame parentKey="CharProg">
                <Size x="60" y="15"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.CharacterFrame" relativePoint="TOPLEFT" x="290" y="-15"/>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString parentKey="CharProg" inherits="GameFontDisableSmall" justifyH="CENTER" justifyV="TOP" maxLines="1">
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent" relativePoint="LEFT" x="0" y="0"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
            <Frame parentKey="CharRio">
                <Size x="60" y="15"/>
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.CharacterFrame.CharIlvl" relativePoint="RIGHT" x="10" y="0"/>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString parentKey="CharRio" inherits="GameFontDisableSmall" justifyH="CENTER" justifyV="TOP" maxLines="1">
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent" relativePoint="LEFT" x="0" y="0"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
            <Button parentKey="RemoveChar" inherits="UIPanelCloseButtonNoScripts">
                <Size x="13" y="13"/>
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeKey="$parent.CharacterFrame" relativePoint="TOPRIGHT" x="-10" y="-6"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        PlaySound(SOUNDKIT.IG_MAINMENU_OPTION_CHECKBOX_ON)
                    </OnClick>
                </Scripts>
            </Button>
            <Button parentKey="UpButton" inherits="QuickKeybindButtonTemplate">
                <Size x="17" y="14"/>
                <Anchors>
                    <Anchor point="RIGHT" relativeKey="$parent.CharacterFrame" relativePoint="RIGHT" x="-8" y="0"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        PlaySound(SOUNDKIT.IG_MAINMENU_OPTION_CHECKBOX_ON)
                    </OnClick>
                </Scripts>
                <NormalTexture atlas="ui-hud-actionbar-pageuparrow-up"/>
                <PushedTexture atlas="ui-hud-actionbar-pageuparrow-down"/>
                <DisabledTexture atlas="ui-hud-actionbar-pageuparrow-disabled"/>
                <HighlightTexture atlas="ui-hud-actionbar-pageuparrow-mouseover"/>
            </Button>
            <Button parentKey="DownButton" inherits="QuickKeybindButtonTemplate">
                <Size x="17" y="14"/>
                <Anchors>
                    <Anchor point="RIGHT" relativeKey="$parent.CharacterFrame" relativePoint="RIGHT" x="-8" y="-28"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        PlaySound(SOUNDKIT.IG_MAINMENU_OPTION_CHECKBOX_ON)
                    </OnClick>
                </Scripts>
                <NormalTexture atlas="ui-hud-actionbar-pagedownarrow-up"/>
                <PushedTexture atlas="ui-hud-actionbar-pagedownarrow-down"/>
                <DisabledTexture atlas="ui-hud-actionbar-pagedownarrow-disabled"/>
                <HighlightTexture atlas="ui-hud-actionbar-pagedownarrow-mouseover"/>
            </Button>
        </Frames>
    </Frame>
</UI>