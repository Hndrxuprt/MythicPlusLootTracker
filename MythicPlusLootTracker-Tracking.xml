<UI>
    <Frame name="MPLT_TrackingEncounterElementTemplate" mixin="MPLT_TrackingElementMixin" virtual="true">
		<Size x="500" y="100"/>
        <Frames>
            <Frame parentKey="EncounterContainer" inherits="MPLT_NineSliceBorderTemplate">
                <Size x="500" y="100"/>
                <Anchors>
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="TOPRIGHT"/>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture parentKey="BackgroundTile" atlas="auctionhouse-background-sell-right" useAtlasSize="true" vertTile="true" horizTile="true">
                            <Color r="1" g="1" b="1" a="1"/>
                            <Anchors>
                                <Anchor point="TOPLEFT" x="4" y="-4" />
                                <Anchor point="BOTTOMRIGHT" x="-4" y="5"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                    <Layer level="ARTWORK">
                        <Texture parentKey="Highlight" atlas="UI-Valdrakken-Highlight-Middle" hidden="false">
                            <Size x="615" y="201"/>
                            <Color r="0.6" g="0.6" b="0.6" a="1"/>
                            <Anchors>
                                <Anchor point="TOP" relativeKey="$parent" relativePoint="TOP" x="0" y="100"/>
                            </Anchors>
                        </Texture>
                        <FontString parentKey="EncounterText" inherits="Fancy48Font" justifyH="CENTER" justifyV="TOP" maxLines="2">
                            <Size x="700" y="30"/>
                            <Anchors>
                                <Anchor point="TOP" relativeKey="$parent" relativePoint="TOP" x="0" y="-15"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
            <Button parentKey="RemoveEnc" inherits="UIPanelCloseButtonNoScripts">
                <Size x="13" y="13"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent.EncounterContainer" relativePoint="TOPLEFT" x="15" y="-11"/>
                </Anchors>
                <Scripts>
					<OnClick>
						PlaySound(SOUNDKIT.IG_MAINMENU_OPTION_CHECKBOX_ON)
					</OnClick>
				</Scripts>
            </Button>
        </Frames>
	</Frame>
    <Frame name="MPLT_TrackingItemElementTemplate" mixin="MPLT_TrackingElementMixin" virtual="true">
        <Frames>
            <Frame parentKey="ItemContainer">
                <Size x="400" y="60"/>
                <Anchors>
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="BOTTOMRIGHT"/>
                </Anchors>
                <Layers>
                    <Layer level="BORDER">
                        <Texture parentKey="ItemBorder" atlas="GarrMissionLocation-Maw-ButtonBG">
                            <Anchors>
                                <Anchor point="TOPLEFT" x="0" y="0"/>
                                <Anchor point="BOTTOMRIGHT" x="0" y="0"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                    <Layer level="ARTWORK">
                        <Texture parentKey="IconBorder" atlas="cyphersetupgrade-rightitem-border-empty">
                            <Size x="67" y="56"/>
                            <Anchors>
                                <Anchor point="RIGHT" relativeKey="$parent.ItemBorder" relativePoint="LEFT" x="12" y="0"/>
                            </Anchors>
                            <TexCoords>
                                <Rect ULx="0" ULy="1" LLx="1" LLy="1" URx="0" URy="0" LRx="1" LRy="0" />
                            </TexCoords>
                        </Texture>
                        <FontString name="$parentCount" inherits="NumberFontNormal" justifyH="RIGHT" hidden="true" parentKey="Count">
                            <Anchors>
                                <Anchor point="BOTTOMRIGHT" x="-5" y="2"/>
                            </Anchors>
                        </FontString>
                        <FontString parentKey="ItemText" inherits="GameFontNormalLarge" justifyH="LEFT" justifyV="TOP" maxLines="1">
                            <Size x="370" y="0"/>
                            <Anchors>
                                <Anchor point="TOPLEFT" relativeKey="$parent.ItemBorder" relativePoint="TOPLEFT" x="20" y="-10"/>
                            </Anchors>
                        </FontString>
                        <FontString parentKey="ItemSince" inherits="NumberFontNormal" justifyH="LEFT" justifyV="TOP" maxLines="1">
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent.ItemBorder" relativePoint="LEFT" x="20" y="-15"/>
                            </Anchors>
                        </FontString>
                        <FontString parentKey="ItemAttempts" inherits="NumberFontNormal" justifyH="LEFT" justifyV="TOP" maxLines="1">
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent.ItemSince" relativePoint="RIGHT" x="5" y="0"/>
                            </Anchors>
                        </FontString>
                        <FontString parentKey="ItemChances" inherits="NumberFontNormal" justifyH="LEFT" justifyV="TOP" maxLines="1">
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent.ItemAttempts" relativePoint="RIGHT" x="5" y="0"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                    <Layer level="OVERLAY">
                        <Texture name="$parentIconTexture" parentKey="icon">
                            <Size x="37" y="37"/>
                            <Anchors>
                                <Anchor point="CENTER" relativeKey="$parent.IconBorder" relativePoint="CENTER" x="-1" y="0"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <Animations>
                    <AnimationGroup parentKey="ShowAnim" looping="NONE" setToFinalAlpha="true">
                        <Alpha duration=".15" fromAlpha="0" toAlpha="1" smoothing="IN"/>
                    </AnimationGroup>
                </Animations>
                <Scripts>
                    <OnEnter>
                        GameTooltip:SetOwner(self, "ANCHOR_RIGHT");
                        GameTooltip:SetText("");
                    </OnEnter>
                    <OnLeave function="GameTooltip_Hide"/>
                </Scripts>
            </Frame>
            <Frame parentKey="ItemDone" hidden="true">
                <Size x="100" y="60"/>
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.ItemContainer" relativePoint="RIGHT" x="5" y="0"/>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture parentKey="DoneBG" atlas="UI-Frame-jailerstower-RerollButton" hidden="false">
                            <Size x="227" y="149"/>
                            <Anchors>
                                <Anchor point="LEFT" x="0" y="0"/>
                                <Anchor point="LEFT" x="-50" y="0"/>
                            </Anchors>
                        </Texture>
                        <FontString parentKey="ItemDoneText" inherits="NumberFontNormal" justifyH="CENTER" justifyV="CENTER" maxLines="4">
                            <Size x="110" y="60"/>
                            <Anchors>
                                <Anchor point="CENTER" relativeKey="$parent.DoneBG" relativePoint="CENTER" x="2" y="0"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
            <Button parentKey="RemoveItem" inherits="UIPanelCloseButtonNoScripts">
                <Size x="13" y="13"/>
                <Anchors>
                    <Anchor point="RIGHT" relativeKey="$parent.ItemContainer" relativePoint="RIGHT" x="-5" y="0"/>
                </Anchors>
                <Scripts>
                    <OnClick>
						PlaySound(SOUNDKIT.IG_MAINMENU_OPTION_CHECKBOX_ON)
					</OnClick>
                </Scripts>
            </Button>
        </Frames>
    </Frame>

    <!-- Compact view: одна строка на подземелье, иконки предметов справа от названия -->
    <Frame name="MPLT_TrackingCompactEncounterElementTemplate" mixin="MPLT_TrackingElementMixin" virtual="true">
        <Size x="400" y="52"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="RowBG" file="Interface\Buttons\White8x8">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="0" y="0"/>
                        <Anchor point="BOTTOMRIGHT" x="0" y="0"/>
                    </Anchors>
                </Texture>
                <!-- Полупрозрачный фон подземелья из EncounterJournal.
                     Фиксированный размер с сохранением пропорций арт-текстуры;
                     маска обрезает видимую область под строку. -->
                <Texture parentKey="DungeonBG" file="Interface\EncounterJournal\UI-EJ-BACKGROUND-Default">
                    <Size x="400" y="430"/>
                    <Anchors>
                        <Anchor point="LEFT" x="0" y="0"/>
                    </Anchors>
                </Texture>
                <MaskTexture parentKey="DungeonMask" file="Interface\CharacterFrame\TempPortraitAlphaMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE" setAllPoints="true"/>
            </Layer>
            <Layer level="BORDER">
                <!-- Рамка-разделитель строк: четыре тонкие полосы по периметру -->
                <Texture parentKey="RowBorderTop" file="Interface\Buttons\White8x8">
                    <Size x="0" y="1"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" x="0" y="0"/>
                        <Anchor point="TOPRIGHT" x="0" y="0"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="RowBorderBottom" file="Interface\Buttons\White8x8">
                    <Size x="0" y="1"/>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" x="0" y="0"/>
                        <Anchor point="BOTTOMRIGHT" x="0" y="0"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="RowBorderLeft" file="Interface\Buttons\White8x8">
                    <Size x="1" y="0"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" x="0" y="0"/>
                        <Anchor point="BOTTOMLEFT" x="0" y="0"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="RowBorderRight" file="Interface\Buttons\White8x8">
                    <Size x="1" y="0"/>
                    <Anchors>
                        <Anchor point="TOPRIGHT" x="0" y="0"/>
                        <Anchor point="BOTTOMRIGHT" x="0" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <!-- Название подземелья — в верхней части строки, до 2 строк.
                     Шрифт/цвет задаётся в Lua: GameFontHighlightMedium + CAMPAIGN_COMPLETE_COLOR. -->
                <FontString parentKey="EncounterText" inherits="GameFontHighlightMedium" justifyH="LEFT" justifyV="TOP" maxLines="2">
                    <Size x="160" y="32"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" x="8" y="-6"/>
                    </Anchors>
                </FontString>
                <!-- Количество попыток в подземелье — под названием.
                     Шрифт/цвет в Lua: GameFontDisableTiny2 + SPELLBOOK_UNLEARNED_TINT_COLOR. -->
                <FontString parentKey="AttemptsText" inherits="GameFontDisableTiny2" justifyH="LEFT" justifyV="BOTTOM" maxLines="1">
                    <Size x="160" y="16"/>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" x="8" y="2"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <!-- Удаление всего подземелья из отслеживания -->
            <Button parentKey="RemoveEnc" inherits="UIPanelCloseButtonNoScripts">
                <Size x="13" y="13"/>
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-2" y="-2"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        PlaySound(SOUNDKIT.IG_MAINMENU_OPTION_CHECKBOX_ON)
                    </OnClick>
                </Scripts>
            </Button>
        </Frames>
    </Frame>

    <!-- Compact view: ячейка предмета — иконка по центру строки, шанс под ней -->
    <Frame name="MPLT_TrackingCompactItemElementTemplate" virtual="true">
        <Size x="32" y="52"/>
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="icon">
                    <Size x="26" y="26"/>
                    <Anchors>
                        <Anchor point="CENTER" x="0" y="6"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <FontString parentKey="Chance" inherits="GameFontDisableTiny" justifyH="CENTER" justifyV="TOP" maxLines="1">
                    <Size x="40" y="14"/>
                    <Anchors>
                        <Anchor point="TOP" relativeKey="$parent.icon" relativePoint="BOTTOM" x="0" y="-4"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnEnter>
                GameTooltip:SetOwner(self, "ANCHOR_RIGHT");
                GameTooltip:SetText("");
            </OnEnter>
            <OnLeave function="GameTooltip_Hide"/>
        </Scripts>
    </Frame>
</UI>