<UI>
	<Frame name="MPLTBackdropTemplate" mixin="MPLTCoreMixin" virtual="true" inherits="BackdropTemplate">
		<Scripts>
			<OnHide method="OnHide"/>
		</Scripts>
	</Frame>
	<Frame name="MPLTFrame" toplevel="true" movable="true" enableMouse="true" hidden="true" parent="UIParent" inherits="ButtonFrameTemplate">
        <Frames>
			<Button name="MPLTFrameTab1" inherits="PanelTabButtonTemplate" id="1" text="CHARACTER">
                <Anchors>
					<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" x="11" y="2"/>
                </Anchors>
                <Scripts>

					<OnEnter>
						GameTooltip:SetOwner(self, "ANCHOR_RIGHT");
						GameTooltip:SetText(CHARACTER_INFO, 1.0,1.0,1.0 );
					</OnEnter>
                </Scripts>
			</Button>
			<Button name="MPLTFrameTab2" inherits="PanelTabButtonTemplate" id="2" text="PVP">
                <Anchors>
                   <Anchor point="LEFT" relativeTo="MPLTFrameTab1" relativePoint="RIGHT" x="-16" y="0"/>
                </Anchors>
                <Scripts>

					<OnEnter>
						GameTooltip:SetOwner(self, "ANCHOR_RIGHT");
						GameTooltip:SetText(PLAYER_V_PLAYER, 1.0,1.0,1.0 );
					</OnEnter>
                </Scripts>
			</Button>
			<Button name="MPLTFrameTab3" inherits="PanelTabButtonTemplate" id="3" text="GUILD">
				<Anchors>
					<Anchor point="LEFT" relativeTo="MPLTFrameTab2" relativePoint="RIGHT" x="-16" y="0"/>
				</Anchors>
				<Scripts>

					<OnEnter>
						GameTooltip:SetOwner(self, "ANCHOR_RIGHT");
						GameTooltip:SetText(GUILD, 1.0,1.0,1.0 );
					</OnEnter>
				</Scripts>
			</Button>
		</Frames>
        <Scripts>
            <OnLoad function="MPLTFrame_OnLoad"/>
        </Scripts>
    </Frame>
</UI>