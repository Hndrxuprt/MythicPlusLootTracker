<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <Frame name="MPLT_RollFrameTemplate" mixin="MPLT_RollFrameMixin" inherits="DefaultPanelFlatTemplate" virtual="true">
		<Size x="300" y="200"/>
        <Layers>
            <Layer level="OVERLAY">
                <Texture parentKey="TimerBar" atlas="activities-bar-fill" alphaMode="ADD" alpha="0.5" >
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent" relativePoint="BOTTOMLEFT" x="10" y="11"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent" relativePoint="BOTTOMRIGHT" x="-10" y="5"/>
                    </Anchors>
                </Texture>
                <FontString parentKey="AutocloseText" inherits="GameFontDisableSmall" justifyH="LEFT" justifyV="MIDDLE" maxLines="1">
                    <Size x="85"/>
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent.TimerBar" relativePoint="LEFT" x="2" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
		<Frames>
            <Frame parentKey="ItemContainer" frameLevel="510">
                <Size x="280" y="80"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeKey="$parent" relativePoint="TOPLEFT" x="6" y="-2"/>
                    <Anchor point="BOTTOMRIGHT" relativeKey="$parent" relativePoint="TOPRIGHT" x="0" y="-22"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <Texture parentKey="ItemLeft" atlas="midnight-scenario-trackerheader-final-filigree" useAtlasSize="false">
                            <Size x="180" y="40"/>
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent" relativePoint="LEFT" x="-11" y="0"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                    <Layer level="BACKGROUND">
                        <Texture parentKey="ItemBG" file="Interface/addons/MythicPlusLootTracker/media/gradient.png" setAllPoints="true"/>
                    </Layer>
                    <Layer level="OVERLAY">
                        <Texture parentKey="ItemIcon">
                            <Size x="22" y="22"/>
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent" relativePoint="LEFT" x="10" y="0"/>
                            </Anchors>
                        </Texture>
                        <MaskTexture parentKey="ItemIconMask" atlas="talents-node-choiceflyout-mask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
                            <MaskedTextures>
                                <MaskedTexture childKey="ItemIcon"/>
                            </MaskedTextures>
                            <Size x="20" y="20"/>
                            <Anchors>
                                <Anchor point="CENTER" relativeKey="$parent.ItemIcon" relativePoint="CENTER" x="0" y="0"/>
                            </Anchors>
                        </MaskTexture>
                        <FontString parentKey="ItemLink" inherits="GameFontDisableSmall" justifyH="LEFT" justifyV="MIDDLE" maxLines="1">
                            <Size x="160"/>
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent.ItemIcon" relativePoint="RIGHT" x="2" y="0"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>
            <Button parentKey="OfferRoll" mixin="MPLT_RollOfferButtonMixin" frameLevel="511">
                <Size x="25" y="25"/>
                <Anchors>
					<Anchor point="TOPRIGHT" x="-30" y="1" relativeKey="$parent" relativePoint="TOPRIGHT"/>
				</Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="OfferTimer" inherits="GameFontDisableSmall" justifyH="LEFT" justifyV="MIDDLE" maxLines="1">
                            <Size x="60"/>
                            <Anchors>
                                <Anchor point="CENTER" relativeKey="$parent" relativePoint="CENTER" x="0" y="0"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <NormalTexture atlas="charactercreate-icon-dice" alpha="1" desaturated="true">
                    <Color r="0.9" g="0.9" b="0.9"/>
                </NormalTexture>
				<HighlightTexture atlas="charactercreate-icon-dice" alphaMode="ADD" alpha="0.3" desaturated="true"/>
				<PushedTexture atlas="charactercreate-icon-dice" alpha="0.8" desaturated="true">
					<Color r="0.5" g="0.5" b="0.5"/>
				</PushedTexture>
                <Scripts>
                    <OnClick method="OnClick"/>
                </Scripts>
            </Button>
            <Button parentKey="ClosePanelButton" inherits="UIPanelCloseButtonDefaultAnchors"/>
			<Frame parentKey="ScrollBox" inherits="WowScrollBoxList">
				<Anchors>
					<Anchor point="TOPLEFT" x="4" y="-22"/>
					<Anchor point="BOTTOM" x="0" y="14"/>
				</Anchors>
			</Frame>
			<EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" x="-16" y="-25"/>
					<Anchor point="BOTTOMLEFT" relativePoint="BOTTOMRIGHT" x="-16" y="6"/>
				</Anchors>
			</EventFrame>
		</Frames>
		<Animations>
            <AnimationGroup parentKey="TimerAnim" looping="NONE" setToFinalAlpha="true">
                <Scale childKey="TimerBar" duration="10.1" order="1" fromScaleX="1" fromScaleY="1" toScaleX="0" toScaleY="1"/>
				<Translation childKey="TimerBar" duration="10.1" order="1" offsetX="-120" offsetY="0"/>
				<Alpha childKey="AutocloseText" startDelay="8.1" smoothing="IN" duration="0.4" order="1" fromAlpha="1" toAlpha="0"/>
                <Scripts>
                    <OnPlay>
                        self:GetParent().AutocloseText:SetAlpha(1)
                    </OnPlay>
                </Scripts>
			</AnimationGroup>
			<AnimationGroup parentKey="ShowAnim" looping="NONE" setToFinalAlpha="true">
				<Translation duration="0.1" offsetY="-10" smoothing="IN"/>
				<Alpha duration="0.1" fromAlpha="1" toAlpha="0" smoothing="IN"/>
			</AnimationGroup>
			<AnimationGroup parentKey="HideAnim" looping="NONE" setToFinalAlpha="true">
				<Translation duration="0.1" offsetY="-10" smoothing="IN"/>
				<Alpha duration="0.1" fromAlpha="1" toAlpha="0" smoothing="IN"/>
			</AnimationGroup>
		</Animations>
        <Scripts>
            <OnLoad>
              tinsert(UISpecialFrames, self:GetName());
            </OnLoad>
            <OnShow>
              PlaySound(SOUNDKIT.IG_CHARACTER_INFO_OPEN);
            </OnShow>
              
          </Scripts>
	</Frame>
    <Button name="MPLT_RollFrameRowTemplate" mixin="MPLT_RollFrameRowMixin" frameStrata="LOW" virtual="true">
        <Size x="200" y="26"/>
        <NormalTexture parentKey="NormalTexture" atlas="auctionhouse-rowstripe-1" setAllPoints="true"/>
        <Frames>
            <Frame parentKey="RollFrame" mixin="MPLT_RollFrameRowMixin" frameStrata="HIGH">
                <Anchors>
                    <Anchor point="TOPLEFT"/>
                    <Anchor point="BOTTOMRIGHT"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
						<Texture parentKey="WinTexture" atlas="Soulbinds_Collection_Entry_Selected" alphaMode="ADD" alpha="0.5" setAllPoints="true" hidden="true" >
							<Color r=".9" g=".9" b=".2" a="1"/>
						</Texture>
                        <FontString parentKey="RollName" inherits="GameFontDisableSmall" justifyH="LEFT" justifyV="MIDDLE" maxLines="1">
                            <Size x="110" y="26"/>
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent" relativePoint="LEFT" x="8" y="0"/>
                            </Anchors>
                            <Color r="1.0" g="1.0" b="1.0"/>
                        </FontString>
						<FontString parentKey="RollAmount" inherits="Game12Font" justifyH="LEFT" justifyV="MIDDLE" maxLines="1" alpha="0">
                            <Size x="40" y="26"/>
                            <Anchors>
                                <Anchor point="LEFT" relativeKey="$parent.RollName" relativePoint="RIGHT" x="0" y="0"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <Animations>
                    <AnimationGroup parentKey="Animation" setToFinalAlpha="true">
						<Alpha childKey="RollAmount" duration="0.1" order="1" fromAlpha="0" toAlpha="1"/>
						<Translation childKey="RollAmount" duration="0" order="1" offsetY="5"/>
						<Translation childKey="RollAmount" duration="0.2" order="1" offsetY="-5"/>
                    </AnimationGroup>
                </Animations>
            </Frame>
            <Frame parentKey="NeedRollAnim" hidden="true" scale="0.4">
				<Size x="100" y="100"/>
				<Anchors>
					<Anchor point="CENTER" relativePoint="CENTER" relativeKey="$parent.RollName" x="5" y="0"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK" textureSubLevel="1">
						<Texture parentKey="DiceGlow" atlas="lootroll-animdiceglow">
							<Size x="70" y="76"/>
							<Anchors>
								<Anchor point="CENTER" x="13" y="-13"/>
							</Anchors>
						</Texture>
					</Layer>
					<Layer level="ARTWORK" textureSubLevel="2">
						<Texture parentKey="FX_RevealB1" atlas="lootroll-animreveal-b">
							<Size x="108" y="150"/>
							<Anchors>
								<Anchor point="CENTER" x="10" y="15"/>
							</Anchors>
						</Texture>
						<Texture parentKey="FX_RevealB2" atlas="lootroll-animreveal-b">
							<Size x="108" y="150"/>
							<Anchors>
								<Anchor point="CENTER" x="23" y="15"/>
							</Anchors>
						</Texture>
					</Layer>
					<Layer level="ARTWORK">
						<Texture parentKey="DiceRoll" atlas="lootroll-animdice">
							<Size x="58" y="74"/>
							<Anchors>
								<Anchor point="CENTER"/>
							</Anchors>
						</Texture>
						<Texture parentKey="FX_RevealA" atlas="lootroll-animreveal-a">
							<Size x="128" y="114"/>
							<Anchors>
								<Anchor point="CENTER" x="19.5" y="-7"/>
							</Anchors>
						</Texture>
						<Texture parentKey="FX_RevealFade" atlas="lootroll-animrevealfade">
							<Size x="70" y="220"/>
							<Anchors>
								<Anchor point="CENTER" x="12.5" y="30"/>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
				<Animations>
					<AnimationGroup parentKey="Animation" mixin="MPLT_RollAnimMixin" setToFinalAlpha="true">
                        <FlipBook childKey="DiceRoll" duration="1.47" order="1" flipBookRows="9" flipBookColumns="5" flipBookFrames="44" flipBookFrameWidth="0" flipBookFrameHeight="0"/>
						<Alpha childKey="DiceRoll" duration="1.47" order="1" fromAlpha="1" toAlpha="1"/>
						<Alpha childKey="DiceRoll" duration="0" order="1" startDelay="1.48" fromAlpha="0" toAlpha="0"/>
						<FlipBook childKey="DiceGlow" duration="1.67" order="1" startDelay="1.48" flipBookRows="10" flipBookColumns="5" flipBookFrames="50" flipBookFrameWidth="0" flipBookFrameHeight="0"/>
						<Alpha childKey="DiceGlow" duration="1.47" order="1" fromAlpha="0" toAlpha="0"/>
						<Alpha childKey="DiceGlow" duration="1.67" order="1" startDelay="1.48" fromAlpha="1" toAlpha="1"/>
						<Scale childKey="DiceGlow" duration="0.27" order="1" startDelay="3.15" fromScaleX="1" fromScaleY="1" toScaleX="1.3" toScaleY="1.3"/>
						<Alpha childKey="DiceGlow" duration="0.27" order="1" startDelay="3.15" fromAlpha="1" toAlpha="0"/>
						<FlipBook childKey="FX_RevealB1" duration="0.3" order="1" startDelay="3.15" flipBookRows="2" flipBookColumns="5" flipBookFrames="10" flipBookFrameWidth="0" flipBookFrameHeight="0"/>
						<Alpha childKey="FX_RevealB1" duration="3.14" order="1" fromAlpha="0" toAlpha="0"/>
						<Alpha childKey="FX_RevealB1" duration="0.3" order="1" startDelay="3.15" fromAlpha="1" toAlpha="1"/>
						<Alpha childKey="FX_RevealB1" duration="0" order="1" startDelay="3.46" fromAlpha="0" toAlpha="0"/>
						<FlipBook childKey="FX_RevealB2" duration="0.35" order="1" startDelay="3.2" flipBookRows="2" flipBookColumns="5" flipBookFrames="10" flipBookFrameWidth="0" flipBookFrameHeight="0"/>
						<Alpha childKey="FX_RevealB2" duration="3.19" order="1" fromAlpha="0" toAlpha="0"/>
						<Alpha childKey="FX_RevealB2" duration="0.35" order="1" startDelay="3.2" fromAlpha="1" toAlpha="1"/>
						<Alpha childKey="FX_RevealB2" duration="0" order="1" startDelay="3.56" fromAlpha="0" toAlpha="0"/>
						<FlipBook childKey="FX_RevealA" duration="0.4" order="1" startDelay="3.3" flipBookRows="2" flipBookColumns="6" flipBookFrames="12" flipBookFrameWidth="0" flipBookFrameHeight="0"/>
						<Alpha childKey="FX_RevealA" duration="3.29" order="1" fromAlpha="0" toAlpha="0"/>
						<Alpha childKey="FX_RevealA" duration="0.4" order="1" startDelay="3.3" fromAlpha="1" toAlpha="1"/>
						<FlipBook childKey="FX_RevealFade" duration="0.7" order="1" startDelay="3.4" flipBookRows="3" flipBookColumns="7" flipBookFrames="21" flipBookFrameWidth="0" flipBookFrameHeight="0"/>
						<Alpha childKey="FX_RevealFade" duration="3.39" order="1" fromAlpha="0" toAlpha="0"/>
						<Alpha childKey="FX_RevealFade" duration="0.7" order="1" startDelay="3.4" fromAlpha="1" toAlpha="1"/>

                        <Scripts>
                            <OnFinished method="OnFinished"/>
                        </Scripts>
                    </AnimationGroup>
				</Animations>
			</Frame>
            <Button parentKey="TradeButton" inherits="UIPanelButtonTemplate"  hidden="false" frameStrata="HIGH">
				<Size x="40" y="26"/>
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.RollFrame.RollAmount" relativePoint="RIGHT" x="0" y="0"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <Texture parentKey="TradeIcon" atlas="housefinder_neighborhood-party-sync-icon">
                            <Size x="20" y="20"/>
                            <Anchors>
                                <Anchor point="CENTER" relativeKey="$parent" relativePoint="CENTER" x="0" y="0"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Button>
        </Frames>
    </Button>
</Ui>